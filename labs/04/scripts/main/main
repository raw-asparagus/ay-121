#!/usr/bin/env python3
"""Lab 4 - Leuschner Sky Survey -- Galactic Plane.

Galactic plane survey driven by the synchronous SurveyCoordinator
(``ugradiolab.capture.coordinator``).  All planning, scheduling, and
hardware glue lives in ``_survey.py``; this script supplies the
galactic-plane configuration and loops forever.

Grid: two-phase brick-pattern tessellation, column-major scan order.
      Even phase: b=[-6, -4, -2, 0, +2, +4, +6], l centered at 120.
      Odd phase:  b=[-5, -3, -1, +1, +3, +5], l offset by half a step.
      Longitude: Delta_l = 2 / cos(b) exactly.
      Scan order: columns of constant l, ascending from L_MIN to L_MAX,
      zig-zagging in b within each column.

Per pointing the LO sequence is ABBA-interleaved across cal/obs:
    CAL-f1, CAL-f2, CAL-f2, CAL-f1, OBS-f1, OBS-f2, OBS-f2, OBS-f1,
    OBS-f1, OBS-f2
where f1=1419.86 MHz, f2=1421.14 MHz.

Run from this directory:
    PYTHONPATH=../../.. python3 main
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _survey import RecalTarget, SurveyConfig, run  # noqa: E402


CONFIG = SurveyConfig(
    title='Galactic Plane',
    output_dir='data/main',
    artifacts_prefix='main',
    timing_archive_dir='data/archive/main',

    # SDR + LO (3.2 MHz, dual LO frequency switch around 1420.4 MHz).
    f1_mhz=1419.86,
    f2_mhz=1421.14,
    sample_rate=3.2e6,
    nsamples=16384,    # 16 chunks * 1024 channels (halved for faster cadence)
    nblocks=1025,
    nfft=1024,

    # Telescope limits.
    min_alt_deg=17.0,
    max_alt_deg=83.0,
    az_min=7.0,
    az_max=348.0,
    track_interval_s=10.0,

    # Sun sidelobe pickup at 1.4 GHz is non-negligible inside ~30 deg.
    sun_avoid_deg=30.0,
    moon_avoid_deg=10.0,

    # Galactic plane bounds.
    l_center=120.0,
    l_min=-10.0,
    l_max=250.0,
    b_min=-6,
    b_max=6,
    b_step=2,
    physical_spacing_deg=2.0,

    # Per-pointing dump schedule (ABBA ABBA ABBA across cal+obs):
    #   CAL-A, CAL-B, CAL-B, CAL-A,
    #   OBS-A, OBS-B, OBS-B, OBS-A, OBS-A, OBS-B, OBS-B, OBS-A
    cal_dumps_per_lo=2,    # 4 cal total
    obs_dumps_per_lo=4,    # 8 obs total

    # Periodic recal drift check.  See _survey.py for target geometry rationale
    # (Dec=+72 pair chosen so at least one is observable at any LST).
    recal_enable=True,
    recal_targets=(
        RecalTarget('obs_recal_drift',    180.0, 72.0),
        RecalTarget('obs_recal_drift_bk',  90.0, 72.0),
    ),
    recal_every_n_cells=10,

    # 'odd' temporarily disabled; re-add to enable interleave phase.
    phases=('even',),
)


if __name__ == '__main__':
    while True:
        run(CONFIG)
